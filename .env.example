# Copy this file to .env.local and fill in real values.

# ---- Admin password ----
# Stored as a scrypt hash (no plaintext on disk). To change the password:
#   npm run hash
# Then paste the printed `ADMIN_PASSWORD_HASH=...` line below and restart.
#
# Default below is the hash of `admin123` so a fresh clone works out of the
# box — CHANGE BEFORE DEPLOYING.
ADMIN_PASSWORD_HASH=ed901354245e50be78e5a6af995f624c:fc54e053d510245044270cea6919612c8d346842541a6fb3288125d3ca2bd43052fb3a9565332986789788e8e9c85113e698363e1e5769d3b6261be7f50a9e1b

# Legacy plaintext password — only used as a fallback if ADMIN_PASSWORD_HASH
# is missing. Deprecated; the server prints a warning when it falls back.
# ADMIN_PASSWORD=admin123

# ---- Session cookie signing ----
# HMAC key for signing admin session cookies. MUST be a long random string in production.
# Generate one with (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET=dev-secret-change-me
